APP_NAME="Website Uptime Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Developer & Committer Metadata
# Developer: Imran Ahmed <me@imrandev.bd>
# Developer Website: https://imrandev.bd

# Multi-Tenancy Configuration
TENANT_SUBDOMAIN_SUFFIX=.uptime.test
MULTI_TENANCY_ENABLED=true

# Database Configuration (PostgreSQL recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uptime_monitor
DB_USERNAME=uptime_user
DB_PASSWORD=secret_password

# Cache, Queue, and Session Storage
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=uptime_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@uptime.test"
MAIL_FROM_NAME="${APP_NAME}"

# Monitoring Probe Mesh & Engine
MONITOR_PROBE_DEFAULT_LOCATION=SIN
MONITOR_TIMEOUT_SECONDS=10
MONITOR_MAX_REDIRECTS=5
MONITOR_RETENTION_DAYS=90
MONITOR_SSRF_STRICT_MODE=true

# Notification Integrations
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TEAMS_WEBHOOK_URL=
WEBHOOK_SECRET_KEY=

# Laravel AI Hub Configuration (imrandevbd/laravel-ai-hub)
AI_HUB_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# PDF Engine (imrandevbd/laravel-unicode-pdf)
UNICODE_PDF_FONT_PATH=
UNICODE_PDF_DEFAULT_FONT=dejavu_sans

# Application Performance Profiler
PROFILER_ENABLED=true
PROFILER_SLOW_QUERY_THRESHOLD_MS=100
PROFILER_MAX_QUERIES_RECORDED=50

# Filesystem / Object Storage
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
