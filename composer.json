{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "imrandevbd/website-uptime-monitor",
    "type": "project",
    "description": "Website Uptime Monitor — Enterprise SaaS Platform for website monitoring, infrastructure observability, incident management, automated alerts, and public status pages.",
    "keywords": ["uptime-monitor", "observability", "incident-management", "status-page", "synthetic-monitoring", "sla", "laravel", "filament"],
    "homepage": "https://imrandev.bd",
    "authors": [
        {
            "name": "Imran Ahmed",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd",
            "role": "Lead Architect & Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.11",
        "imrandevbd/laravel-ai-catalog": "dev-main",
        "imrandevbd/laravel-ai-hub": "^1.7",
        "imrandevbd/laravel-unicode-pdf": "dev-main",
        "imrandevbd/laravel-universal-slug": "dev-main",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
